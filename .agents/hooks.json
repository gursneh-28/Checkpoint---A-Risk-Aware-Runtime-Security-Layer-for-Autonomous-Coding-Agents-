{
  "checkpoint-security-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "if exist checkpoint_hook.cmd (call checkpoint_hook.cmd) else (call .agents\\checkpoint_hook.cmd)",
            "timeout": 330
          }
        ]
      }
    ]
  }
}
